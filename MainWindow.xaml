<Window x:Class="FanGB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FanGB"
        mc:Ignorable="d"
        Title="FanGB" Height="auto" Width="auto"
        Closing="WindowClosing">
    <!-- Resources -->
    <Window.Resources>
        <DataTemplate x:Key="SensorTemplate" DataType="x:Type vm:SensorViewModel">
            <Border BorderBrush="Black" BorderThickness="1" Padding="3">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} ({1}) : {2}">
                            <Binding Path="SensorName"/>
                            <Binding Path="SensorID"/>
                            <Binding Path="SensorValue" Mode="OneWay"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Border>
        </DataTemplate>
        
        <DataTemplate x:Key="HardwareTemplate" DataType="x:Type vm:HardwareViewModel">
            <StackPanel Margin="0,0,50,0">
                <TextBlock FontWeight="Bold" Text="{Binding HardwareType}"/>
                <TextBlock FontWeight="Bold" Text="{Binding HardwareName}"/>
                <ItemsControl ItemsSource="{Binding HardwareSensors}" ItemTemplate="{StaticResource SensorTemplate}"/>
            </StackPanel>
        </DataTemplate>
        
        <ItemsPanelTemplate x:Key="HorizontalItemsPanel">
            <StackPanel Orientation="Horizontal" Margin="10"/>
        </ItemsPanelTemplate>
    </Window.Resources>
    
    <!-- Layout -->
    <DockPanel>
        <TabControl TabStripPlacement="Top">

            <TabItem Header="Monitor" Name="MonitorTab">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Hardware}" ItemTemplate="{StaticResource HardwareTemplate}" ItemsPanel="{StaticResource HorizontalItemsPanel}"/>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Fans">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0">Controls</TextBlock>
                    <TextBlock Grid.Column="1">Curves</TextBlock>
                    <TextBlock Grid.Column="2">Speeds</TextBlock>
                    <TextBlock Grid.Column="3">Sensors</TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="Lighting">
                <TabItem.Content>content here</TabItem.Content>
            </TabItem>
            
        </TabControl>
    </DockPanel>
</Window>
